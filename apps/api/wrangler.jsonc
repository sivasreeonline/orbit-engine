{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-high-coding-judge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "OUTBOX_BATCH_SIZE": "10",
    "OUTBOX_LEASE_SECONDS": "120",
    "OUTBOX_RETRY_BASE_MS": "5000",
    "OUTBOX_RETRY_MAX_MS": "300000",
    "JAVA_RUNTIME_VERSION": "25",
    "PYTHON_RUNTIME_VERSION": "3.14"
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "EXECUTION_QUEUE",
        "queue": "sky-high-execution-requests"
      }
    ],
    "consumers": [
      {
        "queue": "sky-high-execution-requests",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "sky-high-execution-requests-dlq"
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ]
}
