{
  "name": "@sky-high/coding-judge-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "generate-types": "wrangler types",
    "typecheck": "npm run generate-types && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
