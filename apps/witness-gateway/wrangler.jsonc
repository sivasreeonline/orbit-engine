{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-high-witness-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKLOAD_NONCE_REPLAY",
        "class_name": "WorkloadNonceReplayDO"
      },
      {
        "name": "WITNESS_TRUST_STATE",
        "class_name": "WitnessTrustStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-workload-nonce-replay",
      "new_sqlite_classes": [
        "WorkloadNonceReplayDO"
      ]
    },
    {
      "tag": "v2-witness-trust-state",
      "new_sqlite_classes": [
        "WitnessTrustStateDO"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "sky-high-witness-gateway",
      "services": [
        {
          "binding": "WITNESS_PROVIDER",
          "service": "sky-high-witness-provider",
          "entrypoint": "WitnessProvider"
        }
      ]
    }
  }
}
