{
  "name": "@sky-high/private-witness-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate-types": "wrangler types",
    "typecheck": "npm run generate-types && tsc --noEmit",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build": "npm run typecheck && npm test && npm run test:workers && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "@aws-sdk/client-dynamodb": "^3.800.0"
  }
}
