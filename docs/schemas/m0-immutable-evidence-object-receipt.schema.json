{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit-engine.invalid/schemas/m0-immutable-evidence-object-receipt.schema.json",
  "title": "M0 immutable evidence object receipt",
  "description": "Proposed receipt for exact-version object publication and independent readback. It does not prove provider retention semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "provider",
    "bucket_ref",
    "object_key",
    "object_version_id",
    "content_sha256",
    "size_bytes",
    "retention_mode",
    "retain_until",
    "legal_hold",
    "object_lock_configuration_digest",
    "writer_principal",
    "created_at",
    "readback_version_id",
    "readback_sha256",
    "readback_at",
    "evidence_acquirer_principal",
    "independent_verifier_principal",
    "required_retention_until"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "enum": [
        "cloudflare-r2",
        "s3-compatible",
        "other-reviewed-provider"
      ]
    },
    "bucket_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_key": {
      "type": "string",
      "minLength": 1
    },
    "object_version_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "retention_mode": {
      "enum": [
        "governance",
        "compliance",
        "provider-immutable",
        "unverified"
      ]
    },
    "retain_until": {
      "type": "string",
      "format": "date-time"
    },
    "legal_hold": {
      "type": "boolean"
    },
    "object_lock_configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "writer_principal": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "readback_version_id": {
      "type": "string",
      "minLength": 1
    },
    "readback_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "readback_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_acquirer_principal": {
      "type": "string",
      "minLength": 1
    },
    "independent_verifier_principal": {
      "type": "string",
      "minLength": 1
    },
    "required_retention_until": {
      "type": "string",
      "format": "date-time"
    }
  }
}
