{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivasreeonline.github.io/orbit-engine/schemas/m0-verification-audit-checkpoint.schema.json",
  "title": "M0 Signed Verification Audit Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signer_principal", "signer_role", "signer_key_id", "signature_hex", "checkpoint_sha256"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_id", "ledger_epoch", "sequence", "record_sha256", "created_at", "previous_checkpoint_sha256", "policy_version"],
      "properties": {
        "ledger_id": {"type": "string", "minLength": 1},
        "ledger_epoch": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "record_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "previous_checkpoint_sha256": {"type": "string", "pattern": "^(|[A-Fa-f0-9]{64})$"},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "signer_principal": {"type": "string", "minLength": 1},
    "signer_role": {"const": "VERIFICATION_CHECKPOINT_SIGNER"},
    "signer_key_id": {"type": "string", "minLength": 1},
    "signature_hex": {"type": "string", "pattern": "^[A-Fa-f0-9]{128}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
