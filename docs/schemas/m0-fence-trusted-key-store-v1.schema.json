{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyhigh.example/schemas/m0-fence-trusted-key-store-v1.schema.json",
  "title": "FENCE-001 independently governed trusted public-key store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "schemaVersion",
    "storeId",
    "status",
    "approvedBy",
    "approvalReference",
    "keys"
  ],
  "properties": {
    "profile": {
      "const": "sky-high-fence-trusted-key-store-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvalReference": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/key"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "identity",
        "role",
        "publicKeyBase64Url",
        "status",
        "notBefore",
        "notAfter",
        "approvedBy",
        "approvalReference"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "COLLECTOR",
            "INDEPENDENT_VERIFIER"
          ]
        },
        "publicKeyBase64Url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ]
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvalReference": {
          "type": "string",
          "minLength": 1
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVOKED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "revokedAt"
            ]
          }
        }
      ]
    }
  }
}
