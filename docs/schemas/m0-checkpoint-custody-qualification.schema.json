{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivasreeonline.github.io/orbit-engine/schemas/m0-checkpoint-custody-qualification.schema.json",
  "title": "M0 Checkpoint Custody Qualification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_id", "adapter", "environment", "scenarios", "review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "qualification_id": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "product", "api_or_sdk_version", "account_scope", "region", "storage_class", "retention_mode"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "api_or_sdk_version": {"type": "string", "minLength": 1},
        "account_scope": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "storage_class": {"type": "string", "minLength": 1},
        "retention_mode": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "architecture", "endpoint", "encryption_at_rest", "versioning", "replication", "retention_configuration"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "encryption_at_rest": {"type": "string", "minLength": 1},
        "versioning": {"type": "string", "minLength": 1},
        "replication": {"type": "string", "minLength": 1},
        "retention_configuration": {"type": "string", "minLength": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "status", "run_id", "command", "started_at", "completed_at", "evidence"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^CUSTODY-[0-9]{3}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
          "run_id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_reference"}
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_identity", "reviewed_at", "attestation"],
      "properties": {
        "status": {"enum": ["APPROVED", "PENDING", "REJECTED"]},
        "reviewer_identity": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "attestation": {"$ref": "#/$defs/evidence_reference"}
      }
    }
  },
  "$defs": {
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
