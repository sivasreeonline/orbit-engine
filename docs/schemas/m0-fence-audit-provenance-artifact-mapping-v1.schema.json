{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyhigh.example/schemas/m0-fence-audit-provenance-artifact-mapping-v1.schema.json",
  "title": "FENCE-001 audit provenance artifact mapping",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceGroup",
      "sourceArtifact",
      "manifestArtifactId"
    ],
    "properties": {
      "sourceGroup": {
        "enum": [
          "pages",
          "authenticationEvidence",
          "events"
        ]
      },
      "sourceArtifact": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "manifestArtifactId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    }
  }
}
