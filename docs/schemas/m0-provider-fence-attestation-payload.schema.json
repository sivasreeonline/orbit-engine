{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M0 Provider Fence Attestation Payload",
  "description": "Proposed contract schema only. It validates structure and binding metadata; it does not authenticate signatures, verify external provider operations, or authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "provider_account_id",
    "provider_region",
    "resource_id",
    "operation_id",
    "provider_request_id",
    "provider_response_id",
    "fencing_method",
    "fence_state",
    "predecessor_instance_id",
    "predecessor_epoch",
    "predecessor_set_sha256",
    "provider_observed_at",
    "evidence_ref",
    "evidence_sha256"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "provider_account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "provider_region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "provider_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "provider_response_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "fencing_method": {
      "type": "string",
      "enum": [
        "provider-native-generation-fence",
        "provider-native-lease-revocation",
        "provider-native-instance-termination",
        "provider-native-storage-detach",
        "provider-native-control-plane-revocation",
        "other-reviewed-provider-mechanism"
      ]
    },
    "fence_state": {
      "const": "FENCED"
    },
    "predecessor_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"
    },
    "predecessor_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "predecessor_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://.+"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
