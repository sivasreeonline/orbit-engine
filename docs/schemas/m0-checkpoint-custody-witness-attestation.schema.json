{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivasreeonline.github.io/orbit-engine/schemas/m0-checkpoint-custody-witness-attestation.schema.json",
  "title": "M0 Independent Custody Witness Attestation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "attestation", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "Ed25519"},
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "qualification_id",
        "scenario_id",
        "run_id",
        "scenario_status",
        "command",
        "started_at",
        "completed_at",
        "witness_principal",
        "witness_role",
        "witness_key_id",
        "observed_at",
        "decision",
        "evidence_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "qualification_id": {"type": "string", "minLength": 1},
        "scenario_id": {"enum": ["CUSTODY-011", "CUSTODY-012"]},
        "run_id": {"type": "string", "minLength": 1},
        "scenario_status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
        "command": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "witness_principal": {"type": "string", "minLength": 1},
        "witness_role": {"const": "INDEPENDENT_CUSTODY_WITNESS"},
        "witness_key_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "ATTESTED"},
        "evidence_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}