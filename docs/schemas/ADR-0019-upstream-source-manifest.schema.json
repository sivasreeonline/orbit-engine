{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sivasreeonline/orbit-engine/blob/main/docs/schemas/ADR-0019-upstream-source-manifest.schema.json",
  "title": "ADR-0019 Upstream Source Pin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "reviewed_on",
    "retrieval_method",
    "source_pin_policy",
    "entries"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "retrieval_method": {
      "type": "string",
      "minLength": 1
    },
    "source_pin_policy": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "repository",
          "path",
          "source_ref",
          "commit_sha",
          "commit_date",
          "commit_signature_status",
          "commit_signature_reason",
          "blob_sha1",
          "content_sha256",
          "content_byte_length",
          "immutable_file_url",
          "additional_ref_checked",
          "review_use"
        ],
        "properties": {
          "source_id": {
            "enum": [
              "gvisor-rootless",
              "gvisor-containerd",
              "gvisor-platforms",
              "gvisor-networking",
              "containerd-rootless",
              "rootlesskit-v3.3.0",
              "runc-cgroup"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "commit_date": {
            "type": "string",
            "format": "date-time"
          },
          "commit_signature_status": {
            "enum": [
              "verified",
              "unsigned",
              "unknown"
            ]
          },
          "commit_signature_reason": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "immutable_file_url": {
            "type": "string",
            "format": "uri"
          },
          "additional_ref_checked": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_use": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
