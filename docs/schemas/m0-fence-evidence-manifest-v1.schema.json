{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyhigh.example/schemas/m0-fence-evidence-manifest-v1.schema.json",
  "title": "FENCE-001 independently attested evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestBody",
    "manifestDigest",
    "attestations"
  ],
  "properties": {
    "manifestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "schemaVersion",
        "manifestId",
        "createdAt",
        "testOnly",
        "providerScope",
        "adapter",
        "artifacts"
      ],
      "properties": {
        "profile": {
          "const": "sky-high-fence-evidence-manifest-v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "testOnly": {
          "type": "boolean"
        },
        "providerScope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "account",
            "region",
            "service"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "version",
            "configurationDigest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "configurationDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "testIds",
              "artifactType",
              "objectRef",
              "objectVersion",
              "sha256",
              "byteCount",
              "acquiredAt",
              "collectorIdentity",
              "collectorKeyId",
              "independentVerifierIdentity",
              "verifierKeyId",
              "providerRequestIds",
              "redaction"
            ],
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "testIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "WIT-001",
                    "WIT-002",
                    "WIT-003",
                    "WIT-004",
                    "WIT-005",
                    "WIT-006",
                    "WIT-007",
                    "WIT-008",
                    "WIT-009",
                    "WIT-010",
                    "WIT-011",
                    "WIT-012",
                    "WIT-013",
                    "WIT-014"
                  ]
                }
              },
              "artifactType": {
                "enum": [
                  "RAW_PROVIDER_EXCHANGE",
                  "SIGNED_RECEIPT",
                  "MONITOR_OBSERVATION",
                  "FAULT_INJECTION_TRACE",
                  "CONFIGURATION_ATTESTATION",
                  "INDEPENDENCE_ATTESTATION",
                  "RESTORE_TRACE",
                  "CONTRACT_EVIDENCE"
                ]
              },
              "objectRef": {
                "type": "string",
                "minLength": 1
              },
              "objectVersion": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byteCount": {
                "type": "integer",
                "minimum": 1
              },
              "acquiredAt": {
                "type": "string",
                "format": "date-time"
              },
              "collectorIdentity": {
                "type": "string",
                "minLength": 1
              },
              "collectorKeyId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "independentVerifierIdentity": {
                "type": "string",
                "minLength": 1
              },
              "verifierKeyId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "providerRequestIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "redaction": {
                "enum": [
                  "NONE",
                  "REDACTED_WITH_MANIFEST"
                ]
              }
            }
          }
        }
      }
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attestations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "signerIdentity",
          "keyId",
          "signatureBase64Url"
        ],
        "properties": {
          "role": {
            "enum": [
              "COLLECTOR",
              "INDEPENDENT_VERIFIER"
            ]
          },
          "signerIdentity": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signatureBase64Url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      }
    }
  }
}
