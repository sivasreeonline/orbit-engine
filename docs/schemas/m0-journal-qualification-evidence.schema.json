{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivasreeonline.github.io/orbit-engine/schemas/m0-journal-qualification-evidence.schema.json",
  "title": "M0 Journal Qualification Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "catalog_version",
    "adapter",
    "environment",
    "durability_profile",
    "tests",
    "independent_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "driver",
        "driver_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "driver_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "kernel",
        "architecture",
        "filesystem",
        "mount_options",
        "storage_topology"
      ],
      "properties": {
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "mount_options": {
          "type": "string",
          "minLength": 1
        },
        "storage_topology": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "durability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledgement_barrier",
        "power_loss_model",
        "sync_policy",
        "wal_checkpoint_policy"
      ],
      "properties": {
        "acknowledgement_barrier": {
          "type": "string",
          "minLength": 1
        },
        "power_loss_model": {
          "type": "string",
          "minLength": 1
        },
        "sync_policy": {
          "type": "string",
          "minLength": 1
        },
        "wal_checkpoint_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "status",
          "test_run_id",
          "command",
          "started_at",
          "completed_at",
          "evidence"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^JQ-[A-Z]{3}-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "test_run_id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence_reference"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_identity",
        "reviewed_at",
        "attestation"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "PENDING",
            "REJECTED"
          ]
        },
        "reviewer_identity": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "attestation": {
          "$ref": "#/$defs/evidence_reference"
        }
      }
    }
  },
  "$defs": {
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\\\.\\\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
